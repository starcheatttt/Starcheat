<!-- cyberpunk_background.xml -->
<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="45"
        android:startColor="#0a0a0a"
        android:centerColor="#1a1a2e"
        android:endColor="#16213e"
        android:type="linear"/>
</shape>

<!-- neon_glow_bg.xml -->
<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="90"
        android:startColor="#00FFFF"
        android:centerColor="#FF00FF"
        android:endColor="#00FF00"
        android:type="linear"/>
    <corners android:radius="16dp"/>
</shape>

<!-- hexagon_neon.xml -->
<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke
        android:width="4dp"
        android:color="#00FFFF"/>
    <solid android:color="#1A1A2E"/>
</shape>

<!-- terminal_bg.xml -->
<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#0F0F0F"/>
    <stroke
        android:width="1dp"
        android:color="#333333"/>
    <corners android:radius="8dp"/>
</shape>

<!-- console_bg.xml -->
<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
